{
  "name": "tokokasirlussal",
  "version": "1.0.18",
  "description": "Manajemen Toko Kasir - aplikasi kasir Windows, Android, dan PWA",
  "main": "electron/main.cjs",
  "author": "Lussal Design",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "mobile:sync": "npx cap sync android",
    "mobile:open": "npx cap open android"
  },
  "devDependencies": {
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12",
    "@capacitor/cli": "8.5.2"
  },
  "build": {
    "appId": "com.manajemen-toko-kasir.tokokasir",
    "productName": "TokoKasirLussal",
    "icon": "Lussal.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "index.html",
      "index-supabase.html",
      "app.js",
      "config.js"
    ],
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "lussaldesign-code",
      "repo": "TokoKasirLussal",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "TokoKasirLussal-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TokoKasirLussal",
      "perMachine": false,
      "allowElevation": true,
      "differentialPackage": false
    }
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@capacitor/android": "8.5.2",
    "electron-updater": "^6.6.2"
  },
  "engines": {
    "node": ">=22"
  }
}
